ck:\\n\"},\"is_device_based\":false,\"passed\":false},\"2850107578\":{\"name\":\"2850107578\",\"rule_id\":\"7nxmtzMrThjQ6ucoe2XHVB:100.00:19-7nxmty7pqZalN4EsCV24Cz\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"onboarding\":{\"screen_trust_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/trusted_en.png\",\"screen_personalization_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/personalization_en.png\",\"screen_transparency_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/controls_en.png\",\"screen_privacy_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/secure.png\",\"impression_count\":5,\"card_image_url\":\"https://cdn.openai.com/chatgpt/clients/onboarding/onboarding-example-1.png\"},\"android_large_font_scale_threshold\":1.5,\"android_display_zoom_scale_threshold\":1,\"ask_chatgpt_system_message\":\"The user is referring to an ad shown to them about: {LABEL}. Your response MUST BE ABOUT THE ADS shown, since the user explicitly asked about them. They are using the 'Ask ChatGPT' feature and you must reply to the user query using the information about the ads, which is:\\n{DATA}\\n\\nFor example: if the user asks 'Tell me more about these' (or other wordings), then your answer should be about details or further information on products, services, locations etc described in the ad and the links in the ad.\",\"late_ads_event_discard_timeout_seconds\":5,\"late_ads_event_discard_timeout_after_message_end_visibility_seconds\":1},\"is_device_based\":false,\"passed\":true},\"3301430512\":{\"name\":\"3301430512\",\"rule_id\":\"wAmyXvNaSD7QgQBQPWVMI\",\"secondary_exposures\":[],\"id_type\":\"stableID\",\"value\":{\"enabled\":false},\"is_device_based\":true,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"639781334\":{\"name\":\"639781334\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":